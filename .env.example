# Copy this file to .env and fill in the required values.
# Never commit .env or paste its contents into chat, logs, or recordings.

# -----------------------------------------------------------------------------
# Slack — required for live Socket Mode
# -----------------------------------------------------------------------------

# Bot token from OAuth & Permissions. Expected prefix: xoxb-
SLACK_BOT_TOKEN=

# App-level token with connections:write. Expected prefix: xapp-
SLACK_APP_TOKEN=

# IDs, not display names. Use a comma-separated list for multiple channels.
SLACK_ALLOWED_WORKSPACE_ID=
SLACK_ALLOWED_CHANNEL_IDS=

# Channel used by automated live smoke tests. It should also appear above.
SLACK_TEST_CHANNEL_ID=

# Optional second user for the live shared-thread test.
SLACK_SECOND_TEST_USER_ID=

# Socket Mode does not require a signing secret. Add one only if the future
# HTTP Events API path is implemented.
# SLACK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# OpenAI — required for live model calls
# -----------------------------------------------------------------------------

OPENAI_API_KEY=

# All application and evaluation roles use the same selected model.
OPENAI_ROUTER_MODEL=gpt-5.4-mini
OPENAI_SYNTHESIS_MODEL=gpt-5.4-mini
OPENAI_EVAL_MODEL=gpt-5.4-mini

# -----------------------------------------------------------------------------
# LangSmith — required only for live tracing/evaluation
# -----------------------------------------------------------------------------

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=langchain-applied-ai-takehome
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Set this only when the API key can access multiple LangSmith workspaces.
LANGSMITH_WORKSPACE_ID=

# -----------------------------------------------------------------------------
# Local data and persistence
# -----------------------------------------------------------------------------

# Leave the source URL unchanged unless using a manually supplied snapshot.
DATABASE_URL=https://github.com/langchain-ai/applied-ai-take-home-database/raw/4bac5955b1997be7fe2d4c54a09d1aece57d43e1/synthetic_startup.sqlite
DATABASE_SHA256=5bd743daf068f55599e0b93f97f65973298c7123c9d67518f533bd0aa2925c2a

# Set DATABASE_PATH to use an existing verified local copy instead of download.
DATABASE_PATH=

# Runtime-created files; keep them separate from the read-only source database.
CHECKPOINT_DATABASE_PATH=.data/checkpoints.sqlite
EVENT_LEDGER_DATABASE_PATH=.data/events.sqlite
SEMANTIC_INDEX_PATH=.data/semantic-index

# Exact local embedding model will be recorded after retrieval evaluation.
LOCAL_EMBEDDING_MODEL=

# -----------------------------------------------------------------------------
# Runtime and test settings
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
MAX_TOOL_CALLS=8
MAX_QUERY_REWRITES=2

# Set to 1 only when intentionally running tests against Slack/model providers.
RUN_LIVE_TESTS=0
